# Development Environment Variables
# Copy this to .env for local development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/mindpal_dev"

# Supabase (Required for database operations)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# JWT Secret (use a simple one for dev)
JWT_SECRET="dev-jwt-secret-change-this-in-production"

# Google OAuth (for Google Sign-In)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Frontend URL (for OAuth redirects)
WEB_APP_URL="http://localhost:3000"

# AI Provider API Keys
# Google Gemini (FREE - Default Provider)
GOOGLE_API_KEY="your-google-gemini-api-key"

# OpenAI (Paid - Optional)
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Anthropic Claude (Paid - Optional)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"

# DeepSeek AI (Paid - Optional)
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Pinecone Vector Database (for semantic search)
PINECONE_API_KEY="your-pinecone-api-key-here"

# Server Configuration
PORT=3001
NODE_ENV=development
