# Production Environment Variables
# Set these in your Render/Fly.io/Docker deployment dashboard
# DO NOT commit actual values to git!

# Database (from Supabase or managed PostgreSQL)
DATABASE_URL="postgresql://user:password@your-supabase-host.supabase.co:5432/postgres"

# Supabase (Required)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
# JWT Secret (generate secure random string)
JWT_SECRET="[GENERATE-SECURE-64-CHAR-RANDOM-STRING]"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://your-api.onrender.com/api/auth/google/callback"

# Frontend URL
WEB_APP_URL="https://mindpal-learning-app.onrender.com"

# AI Provider API Keys (at least GOOGLE_API_KEY required)
GOOGLE_API_KEY="your-google-gemini-api-key"
OPENAI_API_KEY="sk-your-openai-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"
DEEPSEEK_API_KEY="sk-your-deepseek-key"
PINECONE_API_KEY="your-pinecone-api-key"
GROQ_API_KEY="gsk-your-groq-api-key"
HUGGINGFACE_API_KEY="hf-your-huggingface-key"

# Server Configuration
PORT=8080
NODE_ENV=production
